{
  "name": "jest-mock-vscode",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "version": "4.12.0",
  "description": "VS Code Mock for jest",
  "type": "commonjs",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "author": "Jason Dent",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">22.0.0"
  },
  "scripts": {
    "test": "pnpm test:root && pnpm -r run test",
    "test:root": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist coverage temp",
    "lint": "pnpm run lint:eslint --fix && pnpm run lint:prettier",
    "lint:ci": "pnpm run lint:eslint && pnpm run lint:prettier-ci",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier -w .",
    "lint:prettier-ci": "prettier -c \"**/*.{yaml,yml,md}\"",
    "lint:spelling": "cspell --dot \"**\"",
    "prepublishOnly": "pnpm run build",
    "build-production": "pnpm run build",
    "build": "tsc -b . -f",
    "build:readme": "inject-markdown README.md && pnpm lint:prettier",
    "update-vscode": "pnpm up @types/vscode --latest",
    "watch": "pnpm run build --watch"
  },
  "keywords": [
    "jest",
    "vitest",
    "vscode",
    "mock"
  ],
  "files": [
    "*.js",
    "*.d.ts",
    "dist",
    "!**/__mocks__",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/jest-mock-vscode.git"
  },
  "pnpm": {
    "overrides": {},
    "patchedDependencies": {},
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "inject-markdown": "^4.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rfdc": "^1.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "vscode-uri": "^3.1.0"
  },
  "peerDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
